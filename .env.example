# Copy this file to .env and fill in your actual keys
# NEVER commit .env to git

GROQ_API_KEY=gsk_xxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxx
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxx
GOOGLE_MAPS_KEY=AIzaxxxxxxxxxxxx
APIFY_KEY=apify_api_xxxxxxxxxxxx

# Auth (python -m agents.auth_agent genkey prints both)
JWT_SECRET=xxxxxxxxxxxx
ENCRYPTION_KEY=xxxxxxxxxxxx          # also encrypts connected Facebook sessions
FACEBOOK_APP_ID=xxxxxxxxxxxx
FACEBOOK_APP_SECRET=xxxxxxxxxxxx

# Facebook scraping account for batch runs / users without a connected account.
# Either paste cookies (JSON export, or "c_user=...; xs=...") ...
FB_COOKIES_JSON=
# ... or let setup_fb_cookies.py write .fb_cookies.json (path override below)
# FB_COOKIES_PATH=.fb_cookies.json
# Automated password login is the last resort and the likeliest to hit a checkpoint
# FB_EMAIL=
# FB_PASSWORD=
# FB_AUTO_JOIN=1                     # let the groups agent request to join groups (system account)
# FB_HEADLESS=0                      # show the browser while debugging
